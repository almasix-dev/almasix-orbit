---
/** Listing card used on the browse grid and author pages. */
import type { MarketplacePlugin } from '../../data/marketplace';

interface Props {
	plugin: MarketplacePlugin;
}

const { plugin } = Astro.props;
const initials = plugin.name
	.split(/\s+/)
	.slice(0, 2)
	.map((word) => word[0]?.toUpperCase() ?? '')
	.join('');
const haystack = [
	plugin.name,
	plugin.summary,
	plugin.author.name,
	plugin.package ?? '',
	plugin.repository ?? '',
	plugin.categories.map((category) => category.label).join(' '),
]
	.join(' ')
	.toLowerCase();
---

<li
	class="market-card"
	data-plugin
	data-name={plugin.name.toLowerCase()}
	data-search={haystack}
	data-price={plugin.isPaid ? 'paid' : 'free'}
	data-categories={plugin.categories.map((category) => category.slug).join(' ')}
	data-versions={plugin.orbitVersions.join(' ')}
	data-official={String(plugin.official)}
	data-dark-mode={String(plugin.darkMode)}
	data-published={plugin.publishedAt.toISOString()}
>
	<a class="market-thumb" href={plugin.url} aria-hidden="true" tabindex="-1">
		{
			plugin.thumbnail ? (
				<img src={plugin.thumbnail} alt="" loading="lazy" />
			) : (
				<span class="market-thumb-initials">{initials}</span>
			)
		}
	</a>
	<div class="market-card-body">
		<div class="market-card-head">
			<h3 class="market-card-title"><a href={plugin.url}>{plugin.name}</a></h3>
			<span class="market-chip is-price">{plugin.priceLabel}</span>
		</div>
		<p class="market-summary">{plugin.summary}</p>
		<ul class="market-tags">
			{plugin.official && <li class="market-chip is-official">Official</li>}
			{plugin.featured && <li class="market-chip is-featured">Featured</li>}
			{plugin.categories.map((category) => <li class="market-chip">{category.label}</li>)}
			{plugin.darkMode && <li class="market-chip">Dark mode</li>}
		</ul>
		<p class="market-meta">
			<span>
				by <a href={`/plugins/authors/${plugin.author.slug}/`}>{plugin.author.name}</a>
			</span>
			<span>·</span>
			<span>Orbit {plugin.orbitVersions.join(', ')}</span>
		</p>
	</div>
</li>
