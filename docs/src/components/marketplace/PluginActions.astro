---
/**
 * Primary actions on a plugin listing — GitHub visit + star, install/checkout, docs links.
 */
import StarButton from './StarButton.astro';
import type { MarketplacePlugin } from '../../data/marketplace';

interface Props {
	plugin: MarketplacePlugin;
	showDocsLink?: boolean;
}

const { plugin, showDocsLink = true } = Astro.props;
---

<div class="market-detail-actions not-content">
	{
		plugin.githubUrl && (
			<div class="market-action-group" role="group" aria-label="GitHub">
				<a
					class="market-button market-github-link"
					href={plugin.githubUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg class="market-button-icon" viewBox="0 0 16 16" aria-hidden="true">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.18.82a7.52 7.52 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.51-1.04 2.18-.82 2.18-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
						></path>
					</svg>
					Visit on GitHub
				</a>
				<StarButton
					slug={plugin.slug}
					githubUrl={plugin.githubUrl}
					githubRepo={plugin.githubRepo}
					stars={plugin.stars}
				/>
			</div>
		)
	}
	{
		plugin.isPaid ? (
			<a class="market-button is-primary" href={plugin.checkoutUrl} rel="nofollow noopener">
				<svg class="market-button-icon" viewBox="0 0 20 20" aria-hidden="true">
					<path
						fill="currentColor"
						d="M3 1a1 1 0 0 0-1 1v1h15V2a1 1 0 0 0-1-1H3Zm14 4H2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V5ZM4 7.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5Zm0 3a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5Z"
					></path>
				</svg>
				Buy for {plugin.priceLabel}
			</a>
		) : (
			plugin.repository &&
			!plugin.githubUrl && (
				<a class="market-button is-primary" href={plugin.repository}>
					<svg class="market-button-icon" viewBox="0 0 20 20" aria-hidden="true">
						<path
							fill="currentColor"
							d="M10.5 2.75a.75.75 0 0 0-1.5 0v1.5H7.25a.75.75 0 0 0 0 1.5H9v1.5a.75.75 0 0 0 1.5 0V5.75h1.5a.75.75 0 0 0 0-1.5H10.5V2.75ZM4 6.5A1.5 1.5 0 0 1 5.5 5h9A1.5 1.5 0 0 1 16 6.5v9a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 4 15.5v-9Z"
						></path>
					</svg>
					View source
				</a>
			)
		)
	}
	{
		showDocsLink && plugin.docsUrl && (
			<a class="market-button" href={plugin.docsUrl} target="_blank" rel="noopener noreferrer">
				<svg class="market-button-icon" viewBox="0 0 20 20" aria-hidden="true">
					<path
						fill="currentColor"
						d="M4 4.5A1.5 1.5 0 0 1 5.5 3h5.086a1.5 1.5 0 0 1 1.06.44l2.914 2.914A1.5 1.5 0 0 1 15 7.414V15.5A1.5 1.5 0 0 1 13.5 17h-8A1.5 1.5 0 0 1 4 15.5v-11ZM5.5 4a.5.5 0 0 0-.5.5v11a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5V8h-2.5A1.5 1.5 0 0 1 10.5 6.5V4H5.5Zm6 0v2h2.086L11.5 4Z"
					></path>
				</svg>
				Documentation
			</a>
		)
	}
	{
		plugin.homepage && plugin.homepage !== plugin.docsUrl && (
			<a class="market-button" href={plugin.homepage} target="_blank" rel="noopener noreferrer">
				<svg class="market-button-icon" viewBox="0 0 20 20" aria-hidden="true">
					<path
						fill="currentColor"
						d="M10 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 2ZM4.47 4.47a.75.75 0 0 1 1.06 0l1.06 1.06a.75.75 0 1 1-1.06 1.06L4.47 5.53a.75.75 0 0 1 0-1.06Zm11.06 0a.75.75 0 0 1 0 1.06l-1.06 1.06a.75.75 0 1 1-1.06-1.06l1.06-1.06a.75.75 0 0 1 1.06 0ZM10 7.25a2.75 2.75 0 1 0 0 5.5 2.75 2.75 0 0 0 0-5.5ZM3.25 10a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5h-1.5A.75.75 0 0 1 3.25 10Zm11.25-.75a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1 0-1.5h1.5ZM5.53 14.47a.75.75 0 0 1 1.06 0l1.06 1.06a.75.75 0 1 1-1.06 1.06l-1.06-1.06a.75.75 0 0 1 0-1.06Zm8.94 0a.75.75 0 0 1 0 1.06l-1.06 1.06a.75.75 0 1 1-1.06-1.06l1.06-1.06a.75.75 0 0 1 1.06 0ZM10 15.25a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5a.75.75 0 0 1 .75-.75Z"
					></path>
				</svg>
				Homepage
			</a>
		)
	}
	{
		plugin.changelogUrl && (
			<a class="market-button" href={plugin.changelogUrl} target="_blank" rel="noopener noreferrer">
				<svg class="market-button-icon" viewBox="0 0 20 20" aria-hidden="true">
					<path
						fill="currentColor"
						d="M6.5 2A1.5 1.5 0 0 0 5 3.5v13A1.5 1.5 0 0 0 6.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-13A1.5 1.5 0 0 0 13.5 2h-7ZM6 3.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 .5.5v13a.5.5 0 0 1-.5.5h-7a.5.5 0 0 1-.5-.5v-13Zm2.75 3a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1-.75-.75Z"
					></path>
				</svg>
				Changelog
			</a>
		)
	}
	{
		plugin.pypiUrl && (
			<a class="market-button" href={plugin.pypiUrl} target="_blank" rel="noopener noreferrer">
				<svg class="market-button-icon" viewBox="0 0 20 20" aria-hidden="true">
					<path
						fill="currentColor"
						d="M4 3.5A1.5 1.5 0 0 1 5.5 2h9A1.5 1.5 0 0 1 16 3.5v13a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 4 16.5v-13ZM5.5 3a.5.5 0 0 0-.5.5v13a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-13a.5.5 0 0 0-.5-.5h-9Zm1.75 2.25a.75.75 0 0 1 .75-.75h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1-.75-.75Z"
					></path>
				</svg>
				PyPI
			</a>
		)
	}
</div>
