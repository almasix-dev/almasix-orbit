---
/**
 * Star the plugin's GitHub repo as the visitor via OAuth when configured.
 *
 * Being logged into github.com in the browser is not enough — Orbit needs a
 * one-time GitHub OAuth grant (cookie). Without Worker OAuth secrets the API
 * returns 501 and this button falls back to opening the repository.
 */
import { formatStat } from '../../../scripts/marketplace-lib.mjs';

interface Props {
	slug: string;
	githubUrl: string;
	stars: number | null;
	githubRepo?: string | null;
}

const { slug, githubUrl, stars, githubRepo } = Astro.props;
const repo = githubRepo ?? '';
---

<button
	type="button"
	class="market-button market-star-btn"
	data-star-slug={slug}
	data-star-href={githubUrl}
	data-star-repo={repo}
	aria-pressed="false"
	title="Star this repository on GitHub"
>
	<svg class="market-button-icon market-star-icon" viewBox="0 0 20 20" aria-hidden="true">
		<path
			fill="currentColor"
			d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z"
		></path>
	</svg>
	<span data-star-label>Star</span>
	<span class="market-star-num" data-star-count>{formatStat(stars)}</span>
</button>

<script>
	const starKey = (slug: string) => `orbit-plugin-star:${slug}`;

	const params = new URLSearchParams(location.search);
	const oauthStarred = params.get('starred') === '1';
	const starError = params.get('star');
	if (oauthStarred || starError) {
		params.delete('starred');
		params.delete('star');
		const next = `${location.pathname}${params.toString() ? `?${params}` : ''}${location.hash}`;
		history.replaceState(null, '', next);
	}

	let oauthReady: boolean | null = null;
	fetch('/api/github/status', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
		.then(async (response) => {
			if (!response.ok) {
				oauthReady = false;
				return;
			}
			const data = (await response.json()) as { configured?: boolean };
			oauthReady = Boolean(data.configured);
		})
		.catch(() => {
			oauthReady = false;
		});

	for (const starBtn of document.querySelectorAll<HTMLButtonElement>('.market-star-btn')) {
		const slug = starBtn.dataset.starSlug ?? '';
		const href = starBtn.dataset.starHref ?? '';
		const repo = starBtn.dataset.starRepo ?? '';
		const label = starBtn.querySelector('[data-star-label]');

		const liked = () => Boolean(slug && localStorage.getItem(starKey(slug)));
		const markLiked = () => {
			if (slug) localStorage.setItem(starKey(slug), '1');
		};
		const render = () => {
			const starred = liked();
			starBtn.classList.toggle('is-starred', starred);
			starBtn.setAttribute('aria-pressed', starred ? 'true' : 'false');
			if (label) label.textContent = starred ? 'Starred' : 'Star';
			if (oauthReady === false) {
				starBtn.title = 'Open GitHub to star (Orbit OAuth is not configured on this site)';
			} else if (starred) {
				starBtn.title = 'You starred this repository';
			} else {
				starBtn.title = 'Star this repository on GitHub as you';
			}
		};

		if (oauthStarred) markLiked();
		render();
		const refreshTitle = () => render();
		const statusTimer = window.setInterval(() => {
			if (oauthReady !== null) {
				window.clearInterval(statusTimer);
				refreshTitle();
			}
		}, 100);

		const openGithub = () => {
			if (href) window.open(href, '_blank', 'noopener');
		};

		starBtn.addEventListener('click', async () => {
			if (liked()) {
				openGithub();
				return;
			}
			starBtn.disabled = true;
			try {
				if (!repo) {
					openGithub();
					return;
				}
				// Known-unconfigured site: skip the failing POST and open GitHub.
				if (oauthReady === false) {
					openGithub();
					return;
				}
				const returnPath = `${location.pathname}${location.search}`;
				const response = await fetch(
					`/api/github/star?repo=${encodeURIComponent(repo)}&return=${encodeURIComponent(returnPath)}`,
					{ method: 'POST', headers: { Accept: 'application/json' }, credentials: 'same-origin' },
				);
				if (response.status === 501) {
					oauthReady = false;
					render();
					openGithub();
					return;
				}
				if (response.status === 401) {
					const data = (await response.json()) as { authorize?: string };
					if (data.authorize) {
						// Full-page OAuth — GitHub authorize, then return here with ?starred=1.
						// A github.com login cookie alone cannot star on Orbit's behalf.
						location.href = data.authorize;
						return;
					}
					openGithub();
					return;
				}
				if (!response.ok) {
					openGithub();
					return;
				}
				markLiked();
				render();
			} catch {
				openGithub();
			} finally {
				starBtn.disabled = false;
			}
		});
	}
</script>
