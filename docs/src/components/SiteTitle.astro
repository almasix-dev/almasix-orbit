---
/**
 * Almasix mark plus the primary top-bar menus: Docs, Plugins, and Articles.
 */
import ThemeSiteTitle from '@almasix/starlight-theme/components/SiteTitle.astro';
import {
	isArticlesPath,
	isDocsPath,
	isMarketplacePath,
} from '../../scripts/marketplace-lib.mjs';
import { withDocsBase } from '../versions.mjs';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const onDocs = isDocsPath(path);
const onArticles = isArticlesPath(path);
const onPlugins = isMarketplacePath(path) && !onArticles;
---

<ThemeSiteTitle />
<nav class="header-menus" aria-label="Primary">
	<a href={withDocsBase('/getting-started/installation/', base)} aria-current={onDocs ? 'page' : undefined}>Docs</a>
	<a href={withDocsBase('/plugins/', base)} aria-current={onPlugins ? 'page' : undefined}>Plugins</a>
	<a href={withDocsBase('/articles/', base)} aria-current={onArticles ? 'page' : undefined}>Articles</a>
</nav>

<style>
	:global(.title-wrapper) {
		overflow: visible;
	}
	.header-menus {
		display: flex;
		align-items: center;
		gap: 0.1rem;
		margin-inline-start: 0.35rem;
		padding-inline-start: 0.65rem;
		border-inline-start: 1px solid var(--sl-color-gray-5);
		flex-shrink: 0;
	}
	.header-menus a {
		display: inline-flex;
		align-items: center;
		padding: 0.3rem 0.7rem;
		border-radius: 0.4rem;
		font-size: var(--sl-text-sm);
		font-weight: 650;
		letter-spacing: 0.01em;
		text-decoration: none;
		color: var(--sl-color-gray-2);
		white-space: nowrap;
	}
	.header-menus a:hover {
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
	}
	.header-menus a[aria-current='page'] {
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
	}
</style>
