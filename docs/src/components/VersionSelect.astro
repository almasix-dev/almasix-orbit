---
/**
 * Major + main version switcher. Default / latest is the newest major (`0.x`)
 * at `/0.x/`. `main` is unreleased at `/main/`. Local `astro dev` is unprefixed
 * and is the main tree.
 */
import {
	DOCS_VERSIONS,
	LATEST_VERSION,
	DOCS_VERSION_QUERY,
	hrefForVersion,
	versionFromBase,
} from '../versions.mjs';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const tree = versionFromBase(base);
const options = DOCS_VERSIONS.map((version) => ({
	label: version.label,
	slug: version.slug,
	value: hrefForVersion(base, version.slug, Astro.url.pathname, ''),
	selected: version.slug === tree,
}));
const known = DOCS_VERSIONS.map((version) => version.slug).join(',');
---

<almasix-version-select
	data-base={base}
	data-latest={LATEST_VERSION}
	data-tree={tree}
	data-query={DOCS_VERSION_QUERY}
	data-known={known}
>
	<label class="version-select">
		<span class="sr-only">Documentation version</span>
		<select autocomplete="off" aria-label="Documentation version">
			{
				options.map(({ label, value, slug, selected }) => (
					<option value={value} selected={selected} data-version={slug}>
						{label}
					</option>
				))
			}
		</select>
	</label>
</almasix-version-select>

<script>
	class AlmasixVersionSelect extends HTMLElement {
		connectedCallback() {
			const select = this.querySelector('select');
			if (!(select instanceof HTMLSelectElement)) return;

			const queryKey = this.dataset.query || 'docsVersion';
			const latest = this.dataset.latest || '0.x';
			const tree = this.dataset.tree || 'main';
			const known = (this.dataset.known || latest).split(',').filter(Boolean);

			const stripPrefix = (pathname) => {
				const parts = pathname.split('/').filter(Boolean);
				if (parts[0] && known.includes(parts[0])) {
					const rest = parts.slice(1).join('/');
					return rest ? `/${rest}${pathname.endsWith('/') ? '/' : ''}` : '/';
				}
				return pathname || '/';
			};

			const readCurrent = () => {
				const params = new URLSearchParams(window.location.search);
				const fromQuery = params.get(queryKey);
				const parts = window.location.pathname.split('/').filter(Boolean);
				const head = parts[0];
				if (head && known.includes(head)) return head;
				if (fromQuery && known.includes(fromQuery)) return fromQuery;
				return tree;
			};

			const locationVersioned = () => {
				const head = window.location.pathname.split('/').filter(Boolean)[0];
				return Boolean(head && known.includes(head));
			};

			const hrefFor = (slug) => {
				const params = new URLSearchParams(window.location.search);
				params.delete(queryKey);
				const inner = stripPrefix(window.location.pathname);
				const path =
					!locationVersioned() && slug === tree
						? inner === '/'
							? '/'
							: inner
						: `/${slug}${inner === '/' ? '/' : inner}`;
				const query = params.toString();
				return query ? `${path}?${query}` : path;
			};

			const fromQuery = new URLSearchParams(window.location.search).get(queryKey);
			const pathHead = window.location.pathname.split('/').filter(Boolean)[0];
			if (fromQuery && known.includes(fromQuery) && !known.includes(pathHead)) {
				window.location.replace(hrefFor(fromQuery));
				return;
			}

			const syncFromLocation = () => {
				const current = readCurrent();
				for (const option of select.options) {
					const slug = option.dataset.version || '';
					option.value = hrefFor(slug);
					option.selected = slug === current;
				}
				const page = document.querySelector('.page');
				const banner = document.querySelector('almasix-version-banner');
				const isLatest = current === latest;
				page?.toggleAttribute('data-docs-outdated', !isLatest);
				banner?.toggleAttribute('hidden', isLatest);
				banner?.setAttribute('data-current', current);
				const label = banner?.querySelector('[data-current-label]');
				if (label) label.textContent = current;
				const latestLink = banner?.querySelector('[data-latest-link]');
				if (latestLink instanceof HTMLAnchorElement) {
					latestLink.href = hrefFor(latest);
				}
			};

			syncFromLocation();
			window.addEventListener('popstate', syncFromLocation);

			select.addEventListener('change', () => {
				const href = select.value;
				if (href) window.location.assign(href);
			});

			document.addEventListener(
				'click',
				(event) => {
					const target = event.target;
					if (!(target instanceof Element)) return;
					const anchor = target.closest('a[href]');
					if (!(anchor instanceof HTMLAnchorElement)) return;
					if (anchor.target === '_blank' || anchor.hasAttribute('download')) return;
					if (anchor.hasAttribute('data-latest-link')) return;

					if (!locationVersioned()) return;

					const current = readCurrent();
					let url;
					try {
						url = new URL(anchor.href, window.location.href);
					} catch {
						return;
					}
					if (url.origin !== window.location.origin) return;

					const head = url.pathname.split('/').filter(Boolean)[0];
					if (head === 'api' || (head && known.includes(head))) return;
					if (url.searchParams.has(queryKey)) return;

					url.pathname = `/${current}${url.pathname.startsWith('/') ? url.pathname : `/${url.pathname}`}`;
					url.searchParams.delete(queryKey);
					event.preventDefault();
					window.location.assign(url.toString());
				},
				true,
			);
		}
	}
	customElements.define('almasix-version-select', AlmasixVersionSelect);
</script>

<style>
	.version-select {
		display: flex;
		align-items: center;
		color: var(--sl-color-gray-2);
	}
	.version-select:hover {
		color: var(--sl-color-white);
	}
	.version-select select {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		padding: 0.35rem 0.55rem;
		background-color: transparent;
		color: inherit;
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
		appearance: auto;
		min-width: 4.5rem;
	}
	.version-select option {
		background-color: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-1);
	}
</style>
