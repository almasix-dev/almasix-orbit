---
/**
 * Docs tree on ordinary pages; catalog nav on marketplace listing routes.
 */
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { isMarketplacePath } from '../../scripts/marketplace-lib.mjs';
import MarketplaceNav from './marketplace/MarketplaceNav.astro';
import '../styles/marketplace.css';

const marketplace = isMarketplacePath(Astro.url.pathname);
---

{
	marketplace ? (
		<MarketplaceNav />
	) : (
		<Default>
			<slot />
		</Default>
	)
}

{
	marketplace && (
		<style is:global>
			:root {
				--sl-content-width: 100%;
			}
			.main-pane .sl-container {
				max-width: none;
				width: 100%;
			}
			.pagination-links {
				display: none;
			}
		</style>
	)
}
