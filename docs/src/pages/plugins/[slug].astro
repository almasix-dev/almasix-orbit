---
/** A single marketplace listing. */
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PluginCard from '../../components/marketplace/PluginCard.astro';
import PluginActions from '../../components/marketplace/PluginActions.astro';
import AuthorAside from '../../components/marketplace/AuthorAside.astro';
import {
	getMarketplaceAuthors,
	getMarketplacePlugins,
	getRelatedPlugins,
	renderListingMarkdown,
	RESERVED_PLUGIN_SLUGS,
	type MarketplacePlugin,
} from '../../data/marketplace';
import { fetchListingDocsMarkdown } from '../../../scripts/marketplace-docs.mjs';
import { authorStarsTotal, formatStat } from '../../../scripts/marketplace-lib.mjs';
import '../../styles/marketplace.css';

export const getStaticPaths: GetStaticPaths = async () => {
	const [plugins, authors] = await Promise.all([
		getMarketplacePlugins(),
		getMarketplaceAuthors(),
	]);
	return plugins
		.filter((plugin) => !RESERVED_PLUGIN_SLUGS.includes(plugin.slug))
		.map((plugin) => {
			const group = authors.find((row) => row.author.slug === plugin.author.slug);
			const authorPlugins = group?.plugins ?? [plugin];
			return {
				params: { slug: plugin.slug },
				props: {
					plugin,
					related: getRelatedPlugins(plugin, plugins),
					authorPlugins,
					authorStars: authorStarsTotal(authorPlugins),
				},
			};
		});
};

const { plugin, related, authorPlugins, authorStars } = Astro.props as {
	plugin: MarketplacePlugin;
	related: MarketplacePlugin[];
	authorPlugins: MarketplacePlugin[];
	authorStars: number;
};
const description = await renderListingMarkdown(plugin.description);
const docsMarkdown = await fetchListingDocsMarkdown(plugin.docsUrl, plugin.url);
const docsEmbedded = Boolean(
	docsMarkdown && docsMarkdown.trim() !== plugin.description.trim(),
);
const docsHtml = docsEmbedded ? await renderListingMarkdown(docsMarkdown!) : null;
const showDocsLink = Boolean(plugin.docsUrl && !docsEmbedded);
const published = plugin.publishedAt.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const otherPlugins = authorPlugins.filter((item) => item.slug !== plugin.slug);
---

<StarlightPage
	frontmatter={{
		title: plugin.name,
		description: plugin.summary,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<div class="market market-detail-page" data-marketplace>
		<a class="market-back" href="/plugins/">← All plugins</a>

		<div class="market-detail">
			<div class="market-detail-main">
				<div class="market-detail-head">
					<ul class="market-tags">
						<li class="market-chip is-price">{plugin.priceLabel}</li>
						{plugin.official && <li class="market-chip is-official">Official</li>}
						{plugin.featured && <li class="market-chip is-featured">Featured</li>}
						{plugin.categories.map((category) => (
							<li class="market-chip">
								<a href={`/plugins/categories/${category.slug}/`}>{category.label}</a>
							</li>
						))}
						{plugin.darkMode && <li class="market-chip">Dark mode ready</li>}
					</ul>
					<p class="market-lede">{plugin.summary}</p>
					<PluginActions plugin={plugin} showDocsLink={showDocsLink} />
					{
						plugin.installCommand && (
							<div class="market-install-row">
								<code class="market-install" id="market-install">{plugin.installCommand}</code>
								<button
									type="button"
									class="market-reset"
									id="market-copy"
									data-copy={plugin.installCommand}
								>
									Copy
								</button>
							</div>
						)
					}
					<ul class="market-stats market-stats-lg">
						<li>
							<span class="market-stats-label">Installs</span>
							<strong>{formatStat(plugin.installs)}</strong>
						</li>
						<li>
							<span class="market-stats-label">Stars</span>
							<strong data-star-count-page={plugin.slug}>{formatStat(plugin.stars)}</strong>
						</li>
					</ul>
				</div>

				<dl class="market-facts">
					<div>
						<dt>Author</dt>
						<dd>
							<a href={`/plugins/authors/${plugin.author.slug}/`}>{plugin.author.name}</a>
						</dd>
					</div>
					<div>
						<dt>Orbit versions</dt>
						<dd>{plugin.orbitVersions.join(', ')}</dd>
					</div>
					<div>
						<dt>Package</dt>
						<dd>
							{
								plugin.pypiUrl ? (
									<a href={plugin.pypiUrl} rel="noopener noreferrer">
										{plugin.package}
									</a>
								) : (
									(plugin.package ?? 'Distributed by the author')
								)
							}
						</dd>
					</div>
					{
						plugin.license && (
							<div>
								<dt>License</dt>
								<dd>{plugin.license}</dd>
							</div>
						)
					}
					{
						plugin.requiresPython && (
							<div>
								<dt>Python</dt>
								<dd>{plugin.requiresPython}</dd>
							</div>
						)
					}
					<div>
						<dt>Listed</dt>
						<dd>{published}</dd>
					</div>
				</dl>

				{
					plugin.keywords.length > 0 && (
						<ul class="market-tags">
							{plugin.keywords.map((keyword) => (
								<li class="market-chip">{keyword}</li>
							))}
						</ul>
					)
				}

				<section class="market-description" aria-label="Overview" set:html={description} />

				{
					plugin.screenshots.length > 0 && (
						<section class="market-shots" aria-label="Screenshots">
							{plugin.screenshots.map((shot) => (
								<img src={shot.src} alt={shot.alt} loading="lazy" />
							))}
						</section>
					)
				}

				{
					docsHtml && (
						<section class="market-docs" aria-labelledby="market-docs-heading">
							<div class="market-docs-head">
								<h2 id="market-docs-heading">Documentation</h2>
								{
									plugin.docsUrl && (
										<a
											class="market-docs-source"
											href={plugin.docsUrl}
											target="_blank"
											rel="noopener noreferrer"
										>
											View source
										</a>
									)
								}
							</div>
							<div class="market-description" set:html={docsHtml} />
						</section>
					)
				}

				<div class="market-note">
					<p>
						{
							plugin.official
								? 'This plugin is maintained by the Orbit team.'
								: 'This is a third-party plugin. Almasix does not review or vet its code, and installing it gives it full access to your application.'
						}
						{
							plugin.isPaid &&
								' Payment, licensing, and support are handled by the author on their own store — Orbit is not part of the transaction.'
						}
					</p>
					<p>
						How to install and wire a plugin: <a href="/plugins/using/">Using a plugin</a>. Report
						security issues on the
						<a href="https://github.com/almasix-dev/almasix-orbit/security/advisories/new">
							advisory form</a
						>.
					</p>
				</div>
			</div>

			<AuthorAside
				author={plugin.author}
				pluginCount={authorPlugins.length}
				stars={authorStars}
				otherPlugins={otherPlugins}
			/>
		</div>

		{
			related.length > 0 && (
				<footer class="market-related" aria-labelledby="market-related">
					<h2 id="market-related">Related plugins</h2>
					<ul class="market-grid">
						{related.map((item) => (
							<PluginCard plugin={item} />
						))}
					</ul>
				</footer>
			)
		}
	</div>
</StarlightPage>

<script>
	const button = document.querySelector<HTMLButtonElement>('#market-copy');
	button?.addEventListener('click', async () => {
		const text = button.dataset.copy ?? '';
		try {
			await navigator.clipboard.writeText(text);
			button.textContent = 'Copied';
			window.setTimeout(() => {
				button.textContent = 'Copy';
			}, 1500);
		} catch {
			button.textContent = 'Copy failed';
		}
	});
</script>
