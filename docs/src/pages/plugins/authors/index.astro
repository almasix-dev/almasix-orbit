---
/** Index of authors who have at least one published listing. */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AuthorCard from '../../../components/marketplace/AuthorCard.astro';
import { getMarketplaceAuthors } from '../../../data/marketplace';
import '../../../styles/marketplace.css';

const authors = await getMarketplaceAuthors();
---

<StarlightPage
	frontmatter={{
		title: 'Plugin authors',
		description: 'Everyone who currently maintains a published Orbit plugin listing.',
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<div class="market" data-marketplace>
		<a class="market-back" href="/plugins/">← All plugins</a>
		<p class="market-lede">
			Each author page lists every published plugin and article they maintain. Want to appear
			here? Add an author profile with your first listing — see
			<a href="/plugins/get-listed/">Get listed</a> or
			<a href="/plugins/write-an-article/">Write an article</a>.
		</p>
		{
			authors.length === 0 ? (
				<p class="market-empty">No published authors yet.</p>
			) : (
				<ul class="market-grid">
					{authors.map(({ author, plugins, articles }) => (
						<AuthorCard author={author} plugins={plugins} articles={articles} />
					))}
				</ul>
			)
		}
	</div>
</StarlightPage>
