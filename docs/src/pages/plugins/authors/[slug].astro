---
/** Author profile — bio plus every listing and article they maintain. */
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ArticleCard from '../../../components/marketplace/ArticleCard.astro';
import PluginCard from '../../../components/marketplace/PluginCard.astro';
import {
	authorGithubHref,
	getMarketplaceAuthors,
	type MarketplaceArticle,
	type MarketplaceAuthor,
	type MarketplacePlugin,
} from '../../../data/marketplace';
import { authorStarsTotal, formatStat } from '../../../../scripts/marketplace-lib.mjs';
import '../../../styles/marketplace.css';

export const getStaticPaths: GetStaticPaths = async () => {
	const authors = await getMarketplaceAuthors();
	return authors.map(({ author, plugins, articles }) => ({
		params: { slug: author.slug },
		props: { author, plugins, articles },
	}));
};

const { author, plugins, articles } = Astro.props as {
	author: MarketplaceAuthor;
	plugins: MarketplacePlugin[];
	articles: MarketplaceArticle[];
};
---

<StarlightPage
	frontmatter={{
		title: author.name,
		description: author.bio,
		tableOfContents: false,
		prev: false,
		next: false,
	}}
>
	<div class="market" data-marketplace>
		<a class="market-back" href="/plugins/authors/">← All authors</a>

		<div class="market-author-head">
			{author.avatar && <img class="market-avatar" src={author.avatar} alt="" />}
			<div>
				<p class="market-lede">{author.bio}</p>
				<p class="market-meta">
					{author.website && <a href={author.website}>Website</a>}
					{author.github && <a href={authorGithubHref(author.github)}>GitHub</a>}
					{author.sponsorUrl && <a href={author.sponsorUrl}>Sponsor</a>}
					{
						plugins.length > 0 && (
							<>
								<span>·</span>
								<span>{formatStat(authorStarsTotal(plugins))} stars across listings</span>
							</>
						)
					}
				</p>
			</div>
		</div>

		{
			plugins.length > 0 && (
				<>
					<h2>Plugins</h2>
					<ul class="market-grid">
						{plugins.map((plugin) => (
							<PluginCard plugin={plugin} />
						))}
					</ul>
				</>
			)
		}

		{
			articles.length > 0 && (
				<>
					<h2>Articles</h2>
					<ul class="market-grid">
						{articles.map((article) => (
							<ArticleCard article={article} />
						))}
					</ul>
				</>
			)
		}
	</div>
</StarlightPage>
