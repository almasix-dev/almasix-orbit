{
  "name": "almasix-orbit-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --force",
    "start": "astro dev --force",
    "build": "node scripts/docs-version-build.mjs",
    "build:current": "astro build",
    "marketplace:sync": "node scripts/marketplace-sync.mjs",
    "prebuild": "npm run marketplace:sync && npm run validate:marketplace",
    "validate:marketplace": "node scripts/validate-marketplace.mjs",
    "test": "node --test scripts/validate-marketplace.test.mjs scripts/marketplace-lib.test.mjs scripts/github-star.test.mjs scripts/versions.test.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@almasix/starlight-theme": "^0.1.1",
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.2.10",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "playwright": "^1.63.0",
    "wrangler": "^4.132.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild": true
  }
}
