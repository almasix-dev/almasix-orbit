{
	// Cloudflare Workers Assets + a Worker for GitHub starring on /api/github/*.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "almasix-orbit-docs",
	"main": "scripts/github-star.mjs",
	"compatibility_date": "2026-09-16",
	"preview_urls": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/github/*"],
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	}
}
